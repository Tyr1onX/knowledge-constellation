{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "goal_id", "priorities", "deferred_requirement_ids", "non_learning_constraints"],
  "properties": {
    "version": {"const": "kc.plan.v1"},
    "goal_id": {"type": "string", "minLength": 1},
    "priorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "rank", "title", "requirement_ids", "current_foothold_node_ids", "why_now", "action", "success_evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "rank": {"type": "integer", "minimum": 1, "maximum": 3},
          "title": {"type": "string", "minLength": 1},
          "requirement_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "current_foothold_node_ids": {"type": "array", "items": {"type": "string"}},
          "why_now": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "success_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "deferred_requirement_ids": {"type": "array", "items": {"type": "string"}},
    "non_learning_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "note"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
