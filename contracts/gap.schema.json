{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "goal_id", "items"],
  "properties": {
    "version": {"const": "kc.gap.v1"},
    "goal_id": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_id", "status", "current_node_ids", "current_claim_ids", "current_evidence_ids", "bridge_from_node_ids", "rationale", "boundary", "verification_needed"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["supported", "partial", "unresolved", "not_observed", "not_applicable"]},
          "current_node_ids": {"type": "array", "items": {"type": "string"}},
          "current_claim_ids": {"type": "array", "items": {"type": "string"}},
          "current_evidence_ids": {"type": "array", "items": {"type": "string"}},
          "bridge_from_node_ids": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "string", "minLength": 1},
          "boundary": {"type": "string", "minLength": 1},
          "verification_needed": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
