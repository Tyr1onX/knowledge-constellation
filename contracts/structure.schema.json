{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["anchors", "relations", "motifs", "galaxies", "distillation"],
  "properties": {
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "nodes"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string"},
          "label": {"type": "string"},
          "nodes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "kind", "evidence"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "kind": {"enum": ["co_occurrence", "repeated_context", "trajectory", "practice"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "temporal_basis": {
            "type": "object",
            "required": ["earlier_evidence", "later_evidence", "rationale"],
            "properties": {
              "earlier_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "later_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "trajectory"}}, "required": ["kind"]},
            "then": {"required": ["temporal_basis"]}
          }
        ]
      }
    },
    "motifs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "nodes", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "kind": {"enum": ["work_mode", "goal", "provenance", "cross_cutting_theme"]},
          "nodes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "galaxies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "anchor", "primary_nodes", "secondary_nodes"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "anchor": {"type": "string"},
          "primary_nodes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "secondary_nodes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "distillation": {
      "type": "object",
      "required": ["primary_nodes", "secondary_nodes"],
      "properties": {
        "primary_nodes": {"type": "array", "items": {"type": "string"}},
        "secondary_nodes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
